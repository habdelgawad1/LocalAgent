{"rest": {"RestGenerator": {
  "name": "localagent",
  "uri": "http://127.0.0.1:8800/v1/chat/completions",
  "method": "post",
  "headers": {"Content-Type": "application/json"},
  "req_template_json_object": {"model": "x", "messages": [{"role": "user", "content": "$INPUT"}]},
  "response_json": true,
  "response_json_field": "$.choices[0].message.content",
  "request_timeout": 900
}}}
